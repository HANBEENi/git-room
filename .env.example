# GitHub OAuth App (https://github.com/settings/developers 에서 생성)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# openssl rand -base64 32 로 생성
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AI 문서화(TilDocForm)에 사용. https://aistudio.google.com/apikey 에서 무료로 발급
GEMINI_API_KEY=
